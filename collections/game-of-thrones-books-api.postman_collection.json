  "info": {
    "_postman_id": "c5f19cad-b8d9-4fee-8d85-c6a5176ccfa4",
    "name": "An API of Ice and Fire books API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "An API of Ice and Fire is a free, open REST API providing comprehensive Game of Thrones and A Song of Ice and Fire data including books, characters, and houses from George R.R. Martin's universe. No authentication is required. The API offers structured, quantified data about the HBO series and book series covering all named characters, their allegiances, relationships, book appearances, TV season appearances, and details on every noble house and published book in the series.\n\nContact Support:\n Name: Joakim Skoog",
      "type": "text/plain"
    }
  }
